# Configure these as server-side secrets for the API service. Never prefix them
# with VITE_ and never commit a populated .env file.
RESEND_API_KEY=re_replace_with_your_resend_api_key
QUOTE_FROM_EMAIL=Arzana Website <quotes@mail.arzanaco.com>
# Optional. Defaults to m.saadi@arzanaco.com when not provided.
QUOTE_TO_EMAIL=m.saadi@arzanaco.com
# Create a private Vercel Blob store for up-to-100 MB quote uploads.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_with_your_token
# Long random server-only value used to protect attachment download links.
QUOTE_ATTACHMENT_LINK_SECRET=replace_with_a_long_random_secret
SITE_URL=https://arzanaco.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_server_only_service_role_key

# Public browser configuration for the shared Supabase catalog.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# Resend must verify the domain used in QUOTE_FROM_EMAIL before production email can be delivered.
